{
  "terraform": {
    "required_providers": {
      "docker": { "source": "kreuzwerker/docker", "version": "4.5.0" },
      "random": { "source": "hashicorp/random", "version": "3.7.2" }
    }
  },
  "resource": {
    "random_password": {
      "superuser": { "length": 32, "special": false }
    },
    "docker_image": {
      "postgres": { "name": "postgres:{{version}}", "keep_locally": true }
    },
    "docker_container": {
      "postgres": {
        "name": "{{name}}",
        "image": "${docker_image.postgres.image_id}",
        "restart": "unless-stopped",
        "env": [
          "POSTGRES_PASSWORD=${random_password.superuser.result}",
          "POSTGRES_USER=postgres",
          "POSTGRES_DB=postgres"
        ],
        "ports": [{ "internal": 5432, "external": {{port}} }]
      }
    }
  },
  "output": {
    "host": { "value": "{{host}}" },
    "port": { "value": "{{port}}" },
    "database": { "value": "postgres" },
    "user": { "value": "postgres" },
    "password": { "value": "${random_password.superuser.result}", "sensitive": true }
  }
}
